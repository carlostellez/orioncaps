# Copia este archivo a .env.local y completa los valores reales.
# .env.local NO se sube a git (ya está en .gitignore por defecto en Next.js).

# Google Analytics 4 — Panel > Administrar > Flujos de datos > ID de medición (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Meta Pixel (Facebook/Instagram Ads) — Administrador de eventos > ID del píxel
NEXT_PUBLIC_META_PIXEL_ID=

# LinkedIn Insight Tag — Campaign Manager > Analítica de la cuenta > Insight Tag > Partner ID
# Recomendado especialmente para este negocio: el público objetivo (agencias,
# empresas, startups) se anuncia y se mide mejor en LinkedIn que en redes genéricas.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
